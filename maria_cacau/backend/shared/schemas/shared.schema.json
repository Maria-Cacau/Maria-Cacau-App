{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "$defs compartilhados entre features do backend (hoje: orders/ e conversions/). Migrado de features/orders/schemas/shared.schema.json em 14/09/2026 — Customer e Financial passaram a ser reaproveitados por conversions/, e o resto do domínio de pedido veio junto por ser a mesma família.",
    "$defs": {
        "Address": {
            "description": "Endereço de entrega do pedido. Demais campos podem ser preenchidos via API pública a partir do zip.",
            "type": "object",
            "required": ["zip"],
            "properties": {
                "street":       { "type": "string" },
                "number":       { "type": "string" },
                "complement":   { "type": "string" },
                "neighborhood": { "type": "string" },
                "city":         { "type": "string" },
                "state":        { "type": "string", "minLength": 2, "maxLength": 2 },
                "zip":          { "type": "string" },
                "latitude":     { "type": "number" },
                "longitude":    { "type": "number" }
            }
        },

        "Event": {
            "description": "Evento associado ao presenteado (ex: aniversário, batizado).",
            "type": "object",
            "required": ["type", "date"],
            "properties": {
                "type": { "type": "string", "description": "ex: Aniversário, Batizado, Chá de Bebê" },
                "date": { "type": "string", "description": "formato DD/MM/YY" }
            }
        },

        "Customer": {
            "description": "Quem comprou o pedido.",
            "type": "object",
            "required": ["name"],
            "properties": {
                "name":         { "type": "string" },
                "relationship": { "type": "string", "description": "Parentesco com o presenteado (ex: Mãe, Pai, Amigo(a))" },
                "phone":        { "type": "string" },
                "cpf":          { "type": "string" },
                "email":        { "type": ["string", "null"], "description": "null quando não cadastrado" }
            }
        },

        "Receiver": {
            "description": "Quem vai receber o presente.",
            "type": "object",
            "required": ["name"],
            "properties": {
                "name":   { "type": "string" },
                "gender": { "type": "string", "description": "ex: Masculino, Feminino, Gêmeos" },
                "event":  { "$ref": "#/$defs/Event" }
            }
        },

        "Customization": {
            "description": "Dados de personalização da arte e embalagem do pedido.",
            "type": "object",
            "properties": {
                "label_name":  { "type": "string" },
                "label_theme": { "type": "string" },
                "box_name":    { "type": "string" },
                "box_art":     { "type": "string" }
            }
        },

        "ProductItem": {
            "description": "Um item de produto dentro do pedido.",
            "type": "object",
            "required": ["name", "quantity", "price", "total"],
            "properties": {
                "name":       { "type": "string" },
                "quantity":   { "type": "integer", "minimum": 1 },
                "price":      { "type": "number", "minimum": 0, "description": "Preço unitário do produto" },
                "total":      { "type": "number", "minimum": 0 }
            }
        },

        "PaymentItem": {
            "description": "Uma parcela de pagamento do pedido.",
            "type": "object",
            "required": ["installment", "date", "amount", "type", "confirmed"],
            "properties": {
                "installment": { "type": "integer", "minimum": 1 },
                "date":        { "type": "string", "description": "formato DD/MM/YY" },
                "amount":      { "type": "number", "minimum": 0 },
                "type":        { "type": "string", "description": "ex: Pix, Boleto, Créd 1x" },
                "confirmed":   { "type": "boolean" }
            }
        },

        "Financial": {
            "description": "Dados financeiros do pedido. Só `total` é obrigatório (afrouxado em 14/09/2026, ao ser reaproveitado por conversions/) — os demais campos vêm `null` quando não foram calculados, nunca um zero ou lista vazia fingindo que o valor é conhecido. orders/ continua preenchendo tudo sempre.",
            "type": "object",
            "required": ["total"],
            "properties": {
                "subtotal":       { "type": ["number", "null"], "description": "Soma dos produtos antes de desconto e frete" },
                "discount":       { "type": ["number", "null"] },
                "shipping":       { "type": ["number", "null"], "minimum": 0 },
                "total":          { "type": "number", "description": "Valor final do pedido" },
                "amount_pendent": { "type": ["number", "null"], "description": "negativo = ainda deve" },
                "pay_on_pickup":  { "type": ["boolean", "null"] },
                "payments": {
                    "type": ["array", "null"],
                    "items": { "$ref": "#/$defs/PaymentItem" }
                }
            }
        },

        "Delivery": {
            "description": "Dados de entrega do pedido: data, modalidade e endereço.",
            "type": "object",
            "required": ["date", "type", "receiver_name"],
            "properties": {
                "date":           { "type": "string", "description": "formato DD/MM/YY" },
                "type":           { "type": "string", "description": "ex: MOTOBOY, SEDEX 10, ENTREGA, CANCELADO" },
                "receiver_name":  { "type": "string" },
                "address":        { "$ref": "#/$defs/Address" },
                "factory_notes":  { "type": "string" },
                "motoboy_info":   { "type": "string" }
            }
        },

        "Meta": {
            "description": "Estado bruto do pedido nas colunas `Meta Status`/`Meta Dt Envio` da planilha, sem interpretação de regra de negócio — quem decide se o pedido pode ser enviado é features/conversions, a partir destes mesmos dados. null em cada campo quando a coluna está vazia.",
            "type": "object",
            "properties": {
                "status":  { "type": ["string", "null"], "description": "ex: Enviado, Negado, Teste, Ignorado" },
                "sent_at": { "type": ["string", "null"], "description": "formato DD/MM/YYYY, preenchido só quando status == Enviado" }
            }
        },

        "Order": {
            "description": "Um pedido completo — usado por orders/subfeatures/{summary,payments,detail}.",
            "type": "object",
            "required": ["number", "status", "customer", "receiver", "products", "financial", "delivery"],
            "properties": {
                "number":        { "type": "string" },
                "status":        { "type": "string", "description": "derivado: active | dispatched | cancelled" },
                "source":        { "type": "string", "description": "ex: Instagram, Google, Cliente" },
                "tiny_code":     { "type": "integer", "description": "0 = não integrado ao ERP" },

                "customer":      { "$ref": "#/$defs/Customer" },
                "receiver":      { "$ref": "#/$defs/Receiver" },
                "customization": { "$ref": "#/$defs/Customization" },

                "products": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/ProductItem" }
                },
                "products_note": { "type": "string", "description": "campo livre para produto fora dos slots" },

                "financial": { "$ref": "#/$defs/Financial" },
                "delivery":  { "$ref": "#/$defs/Delivery" },
                "meta": { "$ref": "#/$defs/Meta" }
            }
        }
    }
}
